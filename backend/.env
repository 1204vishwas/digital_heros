# ===============================================
# Digital Heroes Backend Environment Configuration
# ===============================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Secret Key for Authentication
JWT_SECRET=digital-heroes-super-secure-jwt-key-2026-edition

# Database Configuration (SQLite local path)
DATABASE_URL=./digital_heroes.db

# Stripe Payment Gateway (Simulation / Mock Keys)
STRIPE_SECRET_KEY=sk_test_digital_heroes_mock_key_2026
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret_2026

# Supabase Production Deployment (Optional PRD § 15.1)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
